<Project Sdk="Microsoft.NET.Sdk">

  <!-- Experiment: heart rate from the Steam Frame's eye-tracking cameras (camera PPG).
       Windows-only because it decodes JPEG and draws plots with System.Drawing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HeartBeat.EyePpg</RootNamespace>
    <AssemblyName>EyePpg</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HeartBeat.Core\HeartBeat.Core.csproj" />
    <ProjectReference Include="..\..\src\HeartBeat.Tracking\HeartBeat.Tracking.csproj" />
  </ItemGroup>

</Project>
